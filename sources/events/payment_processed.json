{
  "name": "PaymentProcessed",
  "event_code": "EVT-005",
  "event_type": "payment.processed",
  "topic": "pagos.cobros.procesado.v1",
  "version": 1,
  "description": "Evento interno disparado tras el cobro que comunica el resultado al módulo de facturación MOD-002: AUTHORIZED genera factura y REJECTED registra impago (REQ-038).",
  "envelope_schema": "sources/schemas/common/event_envelope.avsc",
  "payload_schema": "sources/schemas/payment_processed.avsc",
  "producer": "ARC-033",
  "consumers": ["ARC-024"],
  "delivery": {
    "retries": 3,
    "backoff": { "strategy": "exponential", "intervals_seconds": [1, 2, 4] },
    "timeout_s": 5
  },
  "malformed_policy": {
    "retryable": false,
    "action": "DEAD_LETTER"
  },
  "outbox": {
    "table": "event_outbox",
    "max_attempts": 10,
    "attempt_interval_seconds": 30,
    "escalation_target": "ADMIN",
    "persist_until_delivered": true
  },
  "payload": {
    "required_fields": [
      "event_id",
      "event_type",
      "timestamp",
      "correlation_id",
      "payment_id",
      "user_id",
      "subscription_id",
      "status",
      "amount",
      "currency"
    ],
    "field_constraints": [
      { "field": "event_type", "type": "string", "enum": ["payment.processed"] },
      { "field": "status", "type": "string", "enum": ["AUTHORIZED", "REJECTED"] },
      { "field": "currency", "type": "string", "length": 3 },
      { "field": "amount", "type": "string", "pattern": "^(0\\.(0[1-9]|[1-9][0-9])|[1-9][0-9]*\\.[0-9]{2})$" }
    ],
    "example": {
      "event_id": "5d2a7c84-6b31-4e29-9f0c-8a71b3e4d5c6",
      "event_type": "payment.processed",
      "timestamp": "2026-10-26T10:35:30.000Z",
      "correlation_id": "1b9d6bcd-bbfd-4b2d-9b5d-ab8dfbbd4bed",
      "payment_id": "c0a8012e-5f44-4d6b-9c11-7e2f8b4a6d33",
      "user_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
      "subscription_id": "a7b4d9e2-3c58-4f1a-8d6e-0b5c9f7a2e41",
      "status": "AUTHORIZED",
      "amount": "45.00",
      "currency": "EUR"
    }
  }
}
