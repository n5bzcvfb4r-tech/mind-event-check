{
  "name": "LedgerDeadLetter",
  "event_code": "EVT-014",
  "event_type": "ledger.deadletter",
  "topic": "gymusers.ledger.dead-letter.v1",
  "version": 1,
  "description": "Canal de cuarentena del consumidor del ledger (MOD-005): un evento económico sin user_id, sin importe o con transición de estado no permitida no llega a transaction_ledger; queda aquí con alerta a ADMIN y no se pierde (REQ-069, AC-TRX-03).",
  "envelope_schema": "sources/schemas/common/event_envelope.avsc",
  "payload_schema": "sources/schemas/ledger_dead_letter.avsc",
  "producer": "ARC-035",
  "consumers": ["ARC-020"],
  "idempotency_key": ["event_id"],
  "delivery": {
    "retries": 3,
    "backoff": { "strategy": "exponential", "intervals_seconds": [1, 2, 4] },
    "timeout_s": 5
  },
  "malformed_policy": {
    "retryable": false,
    "action": "LOG_ONLY"
  },
  "outbox": {
    "table": "event_outbox",
    "max_attempts": 10,
    "attempt_interval_seconds": 30,
    "escalation_target": "ADMIN",
    "persist_until_delivered": true
  },
  "payload": {
    "required_fields": [
      "event_id",
      "event_type",
      "timestamp",
      "correlation_id",
      "original_topic",
      "raw_payload",
      "reject_reason",
      "quarantined_at",
      "alert_target"
    ],
    "field_constraints": [
      { "field": "event_type", "type": "string", "enum": ["ledger.deadletter"] },
      {
        "field": "reject_reason",
        "type": "string",
        "enum": ["MISSING_USER_ID", "MISSING_AMOUNT", "INVALID_STATE_TRANSITION"]
      },
      { "field": "alert_target", "type": "string", "enum": ["ADMIN"] },
      { "field": "original_topic", "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+\\.v[0-9]+$" },
      {
        "field": "quarantined_at",
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"
      },
      { "field": "raw_payload", "type": "string", "pattern": "^(?![\\s\\S]*[0-9]{13,19})[\\s\\S]*$" }
    ],
    "example": {
      "event_id": "9c6f2b14-7d83-4a0e-b5c7-1e8d4f2a6b90",
      "event_type": "ledger.deadletter",
      "timestamp": "2026-10-26T10:35:30.000Z",
      "correlation_id": "1b9d6bcd-bbfd-4b2d-9b5d-ab8dfbbd4bed",
      "original_topic": "pagos.cobros.autorizado.v1",
      "raw_payload": "{\"transaction_id\":\"c0a8012e-5f44-4d6b-9c11-7e2f8b4a6d33\",\"amount_cents\":4500,\"currency\":\"EUR\",\"last_four_digits\":\"0366\"}",
      "reject_reason": "MISSING_USER_ID",
      "quarantined_at": "2026-10-26T10:35:30.000Z",
      "alert_target": "ADMIN"
    }
  }
}
