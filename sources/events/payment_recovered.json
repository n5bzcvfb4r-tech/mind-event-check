{
  "name": "PaymentRecovered",
  "event_code": "EVT-014",
  "event_type": "payment.recovered",
  "topic": "pagos.cobros.recuperado.v1",
  "version": 1,
  "description": "MOD-003 lo publica al cerrar un ciclo de dunning_cycles en RECOVERED. Lo consume MOD-002 (facturación) para dejar la factura UNPAID en PAID con paid_late = true, sin reabrir el ciclo de impago (REQ-118, AC-EST-07).",
  "envelope_schema": "sources/schemas/common/event_envelope.avsc",
  "payload_schema": "sources/schemas/payment_recovered.avsc",
  "producer": "ARC-033",
  "consumers": ["ARC-031"],
  "idempotency_key": ["payment_transaction_id"],
  "delivery": {
    "retries": 3,
    "backoff": { "strategy": "exponential", "intervals_seconds": [1, 2, 4] },
    "timeout_s": 5
  },
  "malformed_policy": {
    "retryable": false,
    "action": "DEAD_LETTER"
  },
  "payload": {
    "required_fields": [
      "event_id",
      "event_type",
      "timestamp",
      "correlation_id",
      "invoice_id",
      "payment_transaction_id",
      "amount",
      "recovered_at"
    ],
    "optional_fields": [],
    "field_constraints": [
      { "field": "event_type", "type": "string", "enum": ["payment.recovered"] },
      { "field": "amount", "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" }
    ],
    "example": {
      "event_id": "4d2f8e1a-6b3c-4f5d-9e0a-1b2c3d4e5f60",
      "event_type": "payment.recovered",
      "timestamp": "2026-10-26T10:35:00.000Z",
      "correlation_id": "1b9d6bcd-bbfd-4b2d-9b5d-ab8dfbbd4bed",
      "invoice_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
      "payment_transaction_id": "9c858901-8a57-4791-81fe-4c455b099bc9",
      "amount": "45.00",
      "recovered_at": "2026-10-26T10:34:55.000Z"
    }
  }
}
